{
  "name": "syntaxlab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "preview:lan": "vite preview --host 0.0.0.0 --port 5175 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:release": "npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
